{
	"schemaVersion": 1,
	"id": "chestlink",
	"version": "${version}",
	"name": "ChestLink",
	"description": "Link vanilla chests into shared-inventory channels with /chestlink. Server-side only: vanilla clients can join and see everything, particles included.",
	"authors": [
		"myl7"
	],
	"contact": {
		"sources": "https://github.com/myl7/chestlink"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.myl7.chestlink.ChestLinkMod"
		]
	},
	"mixins": [
		"chestlink.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-command-api-v2": "*",
		"fabric-lifecycle-events-v1": "*"
	}
}
